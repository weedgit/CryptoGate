# Postgres (docker-compose defaults)
DATABASE_URL=postgres://paymentgate:paymentgate@localhost:5432/paymentgate

# API
API_HOST=0.0.0.0
API_PORT=3000
API_PUBLIC_BASE_URL=http://localhost:3000

# Watcher (separate process; do not merge with API)
WATCHER_POLL_INTERVAL_MS=5000
# Same DATABASE_URL as API — watcher uses its own pool (never imports apps/api).
# When set, each tick loads open payment_orders and calls matchTransaction (M3-41),
# then advances verifying → completed when confirmations meet required (M3-42).
# DATABASE_URL=postgres://paymentgate:paymentgate@localhost:5432/paymentgate
# Local stub: pretend every tx has N confirmations (skip live RPC).
# WATCHER_STUB_CONFIRMATIONS=19
# Local stub transfers JSON (optional smoke): [{"toAddress":"T...","amount":"50.00","txHash":"0x1","network":"tron"}]
# WATCHER_STUB_TRANSFERS=

# Chain surface: mainnet (product / production default) | testnet (local Nile + mainnet pairs).
# Product builds must leave this unset or mainnet — testnet pairs never appear then.
# PAYMENTGATE_CHAIN_ENV=mainnet
# Web (Vite) must match — Asset/Network pickers read VITE_PAYMENTGATE_CHAIN_ENV:
# VITE_PAYMENTGATE_CHAIN_ENV=testnet
# testnet env: UI/API show mainnet + Nile. mainnet env: mainnet only.

# ---------------------------------------------------------------------------
# Chain RPC (read-only). PaymentGate never needs wallet private keys / mnemonics.
# RPC = HTTPS endpoint to a blockchain node or hosted API (TronGrid, Infura, …).
# Optional *_API_KEY = provider rate-limit key — still not a spend key.
# Empty URL → watcher stub for that network (orders on it will not confirm).
# Full catalog: doc/M3-04-Asset-Networks.md
# ---------------------------------------------------------------------------

# Product default pair (also fallback watch scope when no open orders).
# For local Nile: PAYMENTGATE_CHAIN_ENV=testnet, VITE_PAYMENTGATE_CHAIN_ENV=testnet, DEFAULT_NETWORK=tron_nile
# Platform service bills + agent commission remittance use tron_nile automatically in testnet.
DEFAULT_ASSET=USDT
DEFAULT_NETWORK=tron

# Watcher: poll every open asset+network scope in one process (default true).
# Set false to pin ingest to DEFAULT_ASSET + DEFAULT_NETWORK only.
# WATCHER_MULTI_NETWORK=true
# Optional allow-lists — registry ids only (not UI labels like "Arbitrum" / "BSC").
# Omit both to allow every enabled pair. Example covering Phase 1 §VI + Nile:
# WATCHER_NETWORKS=tron,tron_nile,ethereum,bnb_smart_chain,polygon,arbitrum_one,base,solana,ton,bitcoin
# Local Nile-only (faster ticks): WATCHER_NETWORKS=tron_nile
# WATCHER_ASSETS=USDT,USDC,BTC,ETH,TRX

# Tron — USDT TRC-20 + native TRX (TronGrid). Example: https://api.trongrid.io
# Nile testnet (local only): https://nile.trongrid.io
# Empty *_RPC_URL → that network stays stub (orders on it will not complete).
# Hard timeout for every chain HTTP call (ms). Default 15000; caps at 120000.
# CHAIN_FETCH_TIMEOUT_MS=15000
# Per asset+network ingest hard cap in the watcher (match + confirmations).
# WATCHER_SCOPE_TIMEOUT_MS=60000
# Parallel confirming txs (default 8) and ingest scopes (default 4).
# WATCHER_CONFIRM_CONCURRENCY=8
# WATCHER_SCOPE_CONCURRENCY=4

# Mainnet TronGrid (network=tron). Nile-only URL here would leave mainnet stub.
TRON_RPC_URL=
# Nile TronGrid (network=tron_nile). If unset and TRON_RPC_URL is mainnet, defaults to https://nile.trongrid.io
# TRON_NILE_RPC_URL=https://nile.trongrid.io
# Optional TronGrid API key (header TRON-PRO-API-KEY). Separate keys per test/prod — doc/M4-02-Secrets-TLS.md
# TRON_API_KEY=
# TRON_NILE_API_KEY=
# Optional override of Nile USDT contract only (mainnet always uses registry):
# TRON_USDT_CONTRACT=TXYZopYRdj2D9XRtbG411XZZ3kM5VkAeBf

# Ethereum — USDT / USDC ERC-20 + native ETH (JSON-RPC). Example Infura/Alchemy:
# ETH_RPC_URL=https://mainnet.infura.io/v3/YOUR_PROJECT_ID
ETH_RPC_URL=
# ETH_API_KEY=
# ETH_BLOCK_LOOKBACK=2000

# BNB Smart Chain — USDT BEP-20 (decimals 18). Example: https://bsc-dataseed.binance.org
BSC_RPC_URL=
# BSC_API_KEY=
# BSC_BLOCK_LOOKBACK=2000

# Polygon PoS — USDT + USDC
# Prefer a dedicated endpoint (Infura polygon-mainnet / Amoy, or publicnode).
# https://polygon-rpc.com often redirects to a shared Infura key and can 401.
# POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com
POLYGON_RPC_URL=
# POLYGON_API_KEY=
# POLYGON_BLOCK_LOOKBACK=4000

# Arbitrum One — USDT + USDC
# ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
ARBITRUM_RPC_URL=
# ARBITRUM_API_KEY=
# ARBITRUM_BLOCK_LOOKBACK=5000

# Base — USDC
# BASE_RPC_URL=https://mainnet.base.org
BASE_RPC_URL=

# Solana — USDT + USDC SPL
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_RPC_URL=
# SOLANA_API_KEY=

# TON — USDT jetton (TonAPI-compatible base)
# TON_RPC_URL=https://tonapi.io
TON_RPC_URL=
# TON_API_KEY=

# Bitcoin — native BTC (Esplora-compatible)
# BITCOIN_RPC_URL=https://blockstream.info/api
BITCOIN_RPC_URL=

# Watcher adds extra sleep after RPC-error ticks (M3-45, cap 30s). Poll interval still applies.

# Session / auth (Andrew fills real secrets in local .env)
# Use a different SESSION_SECRET per environment — doc/M4-02-Secrets-TLS.md
SESSION_SECRET=change-me-in-local-env
PASSWORD_MIN_LENGTH=12

# Local auth delivery (no SMTP yet). Mail is stub-logged; invite always returns
# temporaryPassword + inviteUrl to the inviter for copy. Forgot-password also stub-logs.
# When true, forgot-password JSON includes resetPath/resetUrl for local testing.
# PASSWORD_RESET_EXPOSE_LINK=true

# Fallback web origin when portal-specific env vars are unset (local dev).
WEB_BASE_URL=http://localhost:5174
# API invite/reset links — must match dedicated portal hosts (production example below).
# PLATFORM_WEB_ORIGIN=https://platform-cg.boostbunny.io
# AGENT_WEB_ORIGIN=https://agent-cg.boostbunny.io
# MERCHANT_WEB_ORIGIN=https://merchant-cg.boostbunny.io
# Dedicated portal subdomains (production/UAT). Local dev: http://platform.localhost:5174 etc.
# PLATFORM_WEB_ORIGIN=http://platform.localhost:5174
# AGENT_WEB_ORIGIN=http://agent.localhost:5174
# MERCHANT_WEB_ORIGIN=http://merchant.localhost:5174
VITE_PLATFORM_WEB_ORIGIN=http://platform.localhost:5174
VITE_AGENT_WEB_ORIGIN=http://agent.localhost:5174
VITE_MERCHANT_WEB_ORIGIN=http://merchant.localhost:5174

# Machine API HMAC (M3-10). Required with X-Api-Key; omit on cg_session / guest /payment.
# Defaults match @paymentgate/domain. Provision keys in api_keys (CRUD is M4-11).
# API_SIGNING_MAX_SKEW_SECONDS=300
# API_SIGNING_NONCE_TTL_SECONDS=600

# Rate limits (M3-11). Defaults from RateLimitPerMinute in @paymentgate/domain.
# RATE_LIMIT_API_KEY_PER_MINUTE=120
# RATE_LIMIT_IP_PER_MINUTE=300
# RATE_LIMIT_LOGIN_PER_MINUTE=10
# RATE_LIMIT_GUEST_PAYMENT_PER_MINUTE=60

# Payment page (guest pay). Encoded in POS/guest QR (`qrPayload`).
# Must be reachable from the payer's phone (LAN IP / tunnel / public host — not only localhost).
# Browser origin must also be allowed by API CORS.
PAYMENT_PAGE_BASE_URL=http://localhost:5173

# Cashier APK (M2-70 / M4-23): emulator default http://10.0.2.2:3000/v1
# Staging vs prod flavors: -Ppaymentgate.stagingApi=… / -Ppaymentgate.prodApi=… (doc/M4-05-Env-Matrix.md)
# Physical device: set LAN API or flavor property — never embed prod keys in debug builds.

# Comma-separated browser origins for guest pay + portals + web dev.
# Include both localhost and 127.0.0.1 if you use either in the address bar.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://platform.localhost:5174,http://agent.localhost:5174,http://merchant.localhost:5174

# Order expiry job (M2-14): pending_payment past expires_at → expired
ORDER_EXPIRY_INTERVAL_MS=30000
# ORDER_EXPIRY_ENABLED=0

# Settlement address cool-down (M2-16). Default 24h.
# SETTLEMENT_COOLDOWN_MS=86400000

# Mode S HD pool: IN_USE → COOLDOWN → FREE (must cover late-payment window). Default 24h.
# HD_POOL_COOLDOWN_MS=86400000

# Platform billing wallet / instructions for service-bill checkout (M3-16).
# Prefer live B11 settings (Platform → Settings → Billing); env is fallback only.
# Platform billing wallet (USDT TRC-20). Required for service-bill checkout QR.
# Testnet: use a Nile-funded Tron address (same T… format). Get Nile USDT from a faucet.
# PLATFORM_BILLING_PAY_TO=TYourNileBillingWalletAddress
# Web invoice face fallbacks when billing-wallet API is unavailable:
# VITE_PLATFORM_BILLING_PAY_TO=TPlatformBillingWalletAddressOrBankRef
# VITE_PLATFORM_INVOICE_SELLER_NAME=PaymentGate
# VITE_PLATFORM_INVOICE_SELLER_EMAIL=billing@example.com

# Webhook delivery worker (M3-14). Defaults from @paymentgate/domain.
# WEBHOOK_DELIVERY_INTERVAL_MS=5000
# WEBHOOK_DELIVERY_ENABLED=0
# WEBHOOK_HTTP_TIMEOUT_MS=10000
# M4-12 load (optional DB / HTTP mode):
# LOAD_M4_12_DB=1
# LOAD_M4_12_HTTP=1
# LOAD_CREATE_N=50
# LOAD_STATUS_N=100
# LOAD_CONCURRENCY=10

