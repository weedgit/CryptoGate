# Postgres (docker-compose defaults)
DATABASE_URL=postgres://cryptogate:cryptogate@localhost:5432/cryptogate

# API
API_HOST=0.0.0.0
API_PORT=3000
API_PUBLIC_BASE_URL=http://localhost:3000

# Watcher (separate process; do not merge with API)
WATCHER_POLL_INTERVAL_MS=5000
# Same DATABASE_URL as API — watcher uses its own pool (never imports apps/api).
# When set, each tick loads open payment_orders and calls matchTransaction (M3-41),
# then advances verifying → completed when confirmations meet required (M3-42).
# DATABASE_URL=postgres://cryptogate:cryptogate@localhost:5432/cryptogate
# Local stub: pretend every tx has N confirmations (skip live RPC).
# WATCHER_STUB_CONFIRMATIONS=19
# Local stub transfers JSON (optional smoke): [{"toAddress":"T...","amount":"50.00","txHash":"0x1","network":"tron"}]
# WATCHER_STUB_TRANSFERS=

# First live network target (M3): USDT on Tron — catalog in @cryptogate/domain USDT_TRON
DEFAULT_ASSET=USDT
DEFAULT_NETWORK=tron
# TronGrid base URL enables live ingest + confirmations (M3-30). Example:
# TRON_RPC_URL=https://api.trongrid.io
TRON_RPC_URL=
# Optional TronGrid API key (header TRON-PRO-API-KEY). Required for higher rate limits.
# TRON_API_KEY=
# Watcher adds extra sleep after trongrid-error ticks (M3-45, cap 30s). Poll interval still applies.

# Session / auth (Andrew fills real secrets in local .env)
SESSION_SECRET=change-me-in-local-env
PASSWORD_MIN_LENGTH=12

# Machine API HMAC (M3-10). Required with X-Api-Key; omit on cg_session / guest /payment.
# Defaults match @cryptogate/domain. Provision keys in api_keys (CRUD is M4-11).
# API_SIGNING_MAX_SKEW_SECONDS=300
# API_SIGNING_NONCE_TTL_SECONDS=600

# Rate limits (M3-11). Defaults from RateLimitPerMinute in @cryptogate/domain.
# RATE_LIMIT_API_KEY_PER_MINUTE=120
# RATE_LIMIT_IP_PER_MINUTE=300
# RATE_LIMIT_LOGIN_PER_MINUTE=10
# RATE_LIMIT_GUEST_PAYMENT_PER_MINUTE=60

# Payment page (guest pay). Browser origin that must be allowed by API CORS.
PAYMENT_PAGE_BASE_URL=http://localhost:5173

# Cashier APK (M2-70): emulator default is http://10.0.2.2:3000/v1 — see doc/Cashier-Apk.md
# Physical device: set API_BASE_URL in apps/cashier-apk/app/build.gradle.kts to your LAN API.

# Comma-separated browser origins for guest pay + create prototype.
# Include both localhost and 127.0.0.1 if you use either in the address bar.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Order expiry job (M2-14): pending_payment past expires_at → expired
ORDER_EXPIRY_INTERVAL_MS=30000
# ORDER_EXPIRY_ENABLED=0

# Settlement address cool-down (M2-16). Default 24h.
# SETTLEMENT_COOLDOWN_MS=86400000

# Mode S HD pool: IN_USE → COOLDOWN → FREE (must cover late-payment window). Default 24h.
# HD_POOL_COOLDOWN_MS=86400000
