# Example reverse proxy — Company A test/staging.
# TLS certificates: terminate at load balancer or certbot on this host.
# Replace api-test.example.com, pay-test.example.com, app-test.example.com.

upstream cryptogate_api {
  server 127.0.0.1:3000;
}

server {
  listen 443 ssl http2;
  server_name api-test.example.com;

  # ssl_certificate     /etc/letsencrypt/live/api-test.example.com/fullchain.pem;
  # ssl_certificate_key /etc/letsencrypt/live/api-test.example.com/privkey.pem;

  location / {
    proxy_pass http://cryptogate_api;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}

server {
  listen 443 ssl http2;
  server_name pay-test.example.com;

  root /opt/cryptogate/apps/payment-page/dist;
  index index.html;

  location / {
    try_files $uri $uri/ /index.html;
  }
}

server {
  listen 443 ssl http2;
  server_name app-test.example.com;

  root /opt/cryptogate/apps/web/dist;
  index index.html;

  location / {
    try_files $uri $uri/ /index.html;
  }

  location /v1/ {
    proxy_pass http://cryptogate_api;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}
