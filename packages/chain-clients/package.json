{
  "name": "@cryptogate/chain-clients",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Per-network chain clients — owned by Bruce.",
  "exports": {
    ".": "./index.mjs",
    "./tron": "./tron/index.mjs",
    "./ethereum": "./ethereum/index.mjs",
    "./bnb_smart_chain": "./bnb_smart_chain/index.mjs"
  },
  "scripts": {
    "build": "node -e \"console.log('@cryptogate/chain-clients: tron + ethereum + bnb_smart_chain ready')\"",
    "typecheck": "node -e \"process.exit(0)\"",
    "test": "pnpm --filter @cryptogate/domain build && node --test test/*.test.mjs",
    "lint": "node -e \"process.exit(0)\""
  },
  "dependencies": {
    "@cryptogate/domain": "workspace:*"
  }
}
