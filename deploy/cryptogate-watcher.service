[Unit]
Description=CryptoGate chain watcher (no inbound ports)
After=network-online.target docker.service cryptogate-api.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/CryptoGate
EnvironmentFile=/etc/cryptogate/watcher.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node apps/watcher/src/main.mjs --loop
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cryptogate-watcher

MemoryMax=1G
MemoryHigh=768M
TasksMax=512
LimitNOFILE=16384

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/root/CryptoGate
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
