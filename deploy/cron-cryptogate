SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin

CRYPTOGATE_BACKUP_DIR=/var/backups/cryptogate
CRYPTOGATE_BACKUP_KEEP_DAYS=14

# 02:40 UTC daily (after qchat 02:15)
40 2 * * * root /root/CryptoGate/deploy/backup.sh >> /var/log/cryptogate-backup.log 2>&1

# Local health + watcher process probe
*/2 * * * * root /root/CryptoGate/deploy/watchdog.sh >/dev/null 2>&1

# Weekly sidecar restore drill (does not stop live API)
10 3 * * 0 root /root/CryptoGate/deploy/restore-drill.sh >> /var/log/cryptogate-drill.log 2>&1
