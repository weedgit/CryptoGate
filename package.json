{
  "name": "paymentgate",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "lint": "pnpm -r --if-present run lint",
    "test": "pnpm -r --if-present run test",
    "typecheck": "pnpm -r --if-present run typecheck",
    "openapi:lint": "pnpm --filter @paymentgate/api-spec run lint",
    "check": "node ./scripts/check.mjs",
    "e2e": "node ./scripts/e2e-smoke.mjs",
    "e2e:check": "node ./scripts/e2e-smoke.mjs --check",
    "deploy:wave5": "node ./scripts/deploy-wave5.mjs",
    "deploy:wave5:down": "node ./scripts/deploy-wave5.mjs --down",
    "deploy:local": "node ./scripts/deploy-wave5.mjs --local"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
